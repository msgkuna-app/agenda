rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "msgkuna.app@gmail.com";
    }

    match /kegiatan/{id}         { allow read, write: if isOwner(); }
    match /kategoriKegiatan/{id} { allow read, write: if isOwner(); }
    match /dokumen/{id}          { allow read, write: if isOwner(); }
    match /kategoriDokumen/{id}  { allow read, write: if isOwner(); }
    match /catatan/{id}          { allow read, write: if isOwner(); }
    match /laporan/{id}          { allow read, write: if isOwner(); }
    match /pengaturan/{id}       { allow read, write: if isOwner(); }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}